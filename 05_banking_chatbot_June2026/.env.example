# ── LLM ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:8b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=4096
# GPU: -1=all layers GPU, 0=CPU only, N=N layers
OLLAMA_NUM_GPU=-1

# ── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=bge-m3:latest

# ── Data ────────────────────────────────────────────────────────────────────
# Path to parquet file (relative to version_3/ or absolute)
PARQUET_PATH=../documents_bgem3.parquet
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION_NAME=vib_products_v3

# ── Retrieval ───────────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=6
TOP_K_FINAL=4
BM25_WEIGHT=0.35
SEMANTIC_WEIGHT=0.65

# ── Advisor ─────────────────────────────────────────────────────────────────
MAX_ADVISOR_TURNS=8

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
