# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every key maps 1:1 to a field in app/settings.py (pydantic-settings reads
# the upper-cased field name). Anything left empty keeps the default there.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_BASE_URL=http://localhost:8000

# --- Optional path overrides (defaults are project-relative) ---
# ASSET_LIBRARY_DIR=./lib
# INPUT_DIR=./input
# OUTPUT_DIR=./output
# SAFE_AREA_GUIDE_DIR=./lib/safe_area_guide

# --- Text LLM (prompt refinement / technique selection / text generation) ---
# LLM_PROVIDER = openai | claude | llama | deepseek | ollama
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-5-mini
LLM_TEXT_GEN=gpt-5-mini
USE_LLM_PROMPT_REFINEMENT=true
# LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Azure AI Foundry gpt-5-mini (fallback used by the "openai" provider when
# LLM_BASE_URL / OPENAI_API_KEY are unset)
AZ_GPT5MINI_ENDPOINT=
AZ_GPT5MINI_KEY=
AZ_GPT5MINI_API_VERSION=2025-08-07

# --- Image GenAI models (config/model_usage.json decides which are used) ---
# Gemini (Vertex AI)
GCP_GEMINI_31_FLASH_IMAGE_ENDPOINT=
GCP_GEMINI_3_PRO_IMAGE_ENDPOINT=
GCP_VERTEX_API_KEY=

# GPT-Image-2 (Azure OpenAI)
AZ_GPT_IMAGE_2_ENDPOINT=
AZ_GPT_IMAGE_2_KEY=

# MAI-Image-2.5 / -Flash / -Pro (Azure)
AZ_MAI_IMAGE_25_ENDPOINT=
AZ_MAI_IMAGE_25_KEY=
AZ_MAI_IMAGE_25_FLASH_ENDPOINT=
AZ_MAI_IMAGE_25_FLASH_KEY=
AZ_MAI_IMAGE_25_PRO_ENDPOINT=
AZ_MAI_IMAGE_25_PRO_KEY=

# FLUX.2-Pro (Azure)
AZ_FLUX_2_PRO_ENDPOINT=
AZ_FLUX_2_PRO_KEY=

# --- Runtime tuning ---
HTTP_TIMEOUT_SECONDS=600
HTTP_MAX_RETRIES=3
GENERATION_MAX_WORKERS=2
ATTACH_IMAGE_MAX_DIM=1024
ATTACH_IMAGE_JPEG_QUALITY=85
